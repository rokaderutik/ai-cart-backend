# The dev profile imports the root .env file as Java properties.
# Keep values unquoted; do not prefix keys with export.
# Use a Neon JDBC URL such as jdbc:postgresql://HOST/DB?sslmode=require.
DB_JDBC_URL=jdbc:postgresql://HOST/DB?sslmode=require
DB_USERNAME=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY
FRONTEND_ORIGIN=http://localhost:5173
